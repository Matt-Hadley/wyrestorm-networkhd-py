{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|MultiEdit|Write",
                "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-protected.sh" }]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|MultiEdit|Write",
                "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-after-edit.sh" }]
            }
        ]
    }
}
